<?xml version="1.0" encoding="UTF-8"?>
<!--
  MONK GRAIN — Módulo de catálogo de pergamino con acceso JDBC
  GA7-220501096-AA2-EV01

  Conexión directa por JDBC, sin ORM: la evidencia pide demostrar
  el acceso a datos a ese nivel, con PreparedStatement y manejo
  explícito de recursos y transacciones.

  PostgreSQL y no MySQL porque es el motor que usa la aplicación
  MONK GRAIN: el módulo habla el mismo dialecto que el producto.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>co.monkgrain</groupId>
  <artifactId>catalogo-pergamino</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>MONK GRAIN - Catalogo de pergamino (JDBC)</name>
  <description>
    Modulo de catalogo de lotes de cafe pergamino seco con acceso a datos por JDBC.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <postgresql.version>42.7.4</postgresql.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Controlador JDBC de PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>

    <!-- Pruebas -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>catalogo-pergamino</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Empaqueta el modulo con sus dependencias, para poder
           ejecutarlo con `java -jar` sin preparar el classpath. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>co.monkgrain.catalog.MainCatalog</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
