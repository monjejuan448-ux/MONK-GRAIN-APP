<?xml version="1.0" encoding="utf-8"?>
<!--
  MONK GRAIN móvil — GA8-220501096-AA2-EV02

  Lo que no está declarado aquí no existe para el sistema: una Activity sin
  su entrada no se puede abrir aunque la clase esté dentro del APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      El único permiso que necesita la aplicación. INTERNET es un permiso
      normal, no peligroso: se concede al instalar y no abre ningún diálogo.
      Pedir más —ubicación, cámara, contactos— costaría usuarios sin dar
      nada: consultar el catálogo no necesita saber dónde está nadie.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonkGrain"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          `exported="true"` SOLO aquí, porque es la que abre el lanzador.
          Una Activity exportada puede ser lanzada por cualquier otra
          aplicación del teléfono; la de detalle no lo está, así que solo se
          puede abrir desde dentro.
        -->
        <activity
            android:name=".ui.LotListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LotDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.LotListActivity" />
    </application>
</manifest>
