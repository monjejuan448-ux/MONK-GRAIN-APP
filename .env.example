# ============================================================
# MONK GRAIN — Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# Ningún valor real debe versionarse.
# ============================================================

# ---------- Aplicación ----------
APP_NAME=MONK GRAIN
APP_ENV=development                      # development | staging | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
WEB_PORT=3000

# ---------- Base de datos ----------
POSTGRES_USER=monkgrain
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=monkgrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://monkgrain:change_me_in_production@postgres:5432/monkgrain

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Seguridad ----------
# Genera una clave con: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Clave de cifrado de la cuenta bancaria del vendedor. Si se deja vacía se
# deriva de SECRET_KEY, que sirve en desarrollo pero no en producción: rotar
# SECRET_KEY dejaría ilegible lo ya cifrado. Genera una con:
#   docker compose exec backend python -c "from app.core.crypto import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Límite de peticiones ----------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ---------- Almacenamiento de archivos (MinIO en desarrollo) ----------
S3_ENDPOINT_URL=http://minio:9000
# URL con la que el navegador pide las imágenes. Se sirve a través del
# proxy de Next (/media) para que el optimizador, que corre en el
# servidor, alcance el almacenamiento por la red interna de Docker.
S3_PUBLIC_URL=http://localhost:3000/media
S3_ACCESS_KEY=monkgrain_dev
S3_SECRET_KEY=change_me_in_production
S3_BUCKET=monkgrain
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# ---------- Correo (Mailpit en desarrollo) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=no-reply@monkgrain.co
MAIL_FROM_NAME=MONK GRAIN

# ---------- Negocio ----------
DEFAULT_CURRENCY=COP
DEFAULT_COMMISSION_RATE=0.025           # 2,5% por venta (ver docs/17 §5)
DEFAULT_LOCALE=es-CO
LOW_STOCK_THRESHOLD=5

# ---------- Pagos ----------
# En el MVP el proveedor es simulado: no requiere credenciales.
# Las claves reales se añaden cuando se active una pasarela.
PAYMENT_PROVIDER=simulated              # simulated | wompi | mercadopago | payu
PAYMENT_WEBHOOK_SECRET=change_me_in_production

# ---------- Logística ----------
# En el MVP el operador es simulado: genera guías y estados de prueba.
SHIPPING_PROVIDER=simulated             # simulated | servientrega | coordinadora | interrapidisimo

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL que usa el servidor de Next.js para llamar a la API (red interna de Docker)
API_INTERNAL_URL=http://backend:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Debe ser el mismo que DEFAULT_LOCALE del backend, y con región.
# Con «es» a secas, Intl no agrupa los miles en cifras de cuatro dígitos:
# «6775 kg» junto a «12.000 kg» en la misma lista.
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO
