          "name": "4.6 Con la contraseña CORRECTA → 429 y Retry-After",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "La contraseña es buena y la cuenta está frenada. Es el único caso en que el servicio explica el motivo real."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 429 y no 403', function () {",
                  "    // El 403 dice «no puedes, y no insistas»; el 429 dice «ahora no,",
                  "    // vuelve después», que es la verdad.",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "",
                  "pm.test('Trae Retry-After en segundos', function () {",
                  "    // Así lo entienden los clientes que reintentan solos, sin leer el",
                  "    // mensaje.",
                  "    const espera = pm.response.headers.get('Retry-After');",
                  "    pm.expect(Number(espera)).to.be.above(0).and.at.most(900);",
                  "});",
                  "",
                  "pm.test('A quien acierta la contraseña sí se le explica', function () {",
                  "    // Es el único caso en que se dice la verdad completa: quien llega",
                  "    // aquí ya demostró ser el dueño de la cuenta.",
                  "    const cuerpo = pm.response.json();",
                  "    pm.expect(cuerpo.error).to.eql('account_locked');",
                  "    pm.expect(cuerpo.message).to.include('minutos');",
                  "});"
                ]
              }
            }
          ]
